# DataSF API Token
# Get your free token at: https://data.sfgov.org/
# 1. Create free account
# 2. Go to Profile → App Tokens
# 3. Copy your token and paste below
DATASF_API_TOKEN=your_datasf_token_here

# DataSF API Endpoints (do not change)
DATASF_CRIME_API=https://data.sfgov.org/resource/gnap-fj3t.json
DATASF_311_API=https://data.sfgov.org/resource/vw6y-z8j6.json

# GraphHopper API Key
# Get your free key at: https://www.graphhopper.com/
# 1. Sign up for free account
# 2. Go to Dashboard → API Keys
# 3. Copy your key and paste below
# Note: Free tier allows ~5 requests/minute
GRAPHHOPPER_API_KEY=your_graphhopper_key_here

# Backend Configuration (can be customized)
BACKEND_PORT=8000
FRONTEND_URL=http://localhost:3000

# Data Refresh Interval (minutes)
DATA_REFRESH_INTERVAL=10
